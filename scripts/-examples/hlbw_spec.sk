on skript start:
    set {tlengame} to false
    set {bluerespawn} to false
    set {redrespawn} to false
    set {tlendiamonds} to false
    set {tlenemeralds} to false
    set {tlenroundtimer} to 0

on shoot:
    if projectile is an egg:
        if shooter is a player:
            set {_y} to y-coordinate of shooter
            wait 1 tick
            loop 50 times:
                wait 1 tick
                if projectile is in region "tlen2":
                    if projectile is in region "tlen3":
                        kill projectile
                        send "&e&l[HLBW] &r&cNie możesz tego tutaj użyć" to shooter
                    else:
                        if projectile is in region "tlen4":
                            kill projectile
                            send "&e&l[HLBW] &r&cNie możesz tego tutaj użyć" to shooter
                        else:
                            set {_x} to x-coordinate of projectile
                            set {_z} to z-coordinate of projectile
                            set {_loc} to location at {_x}, {_y}, {_z} in world of projectile
                            if block at {_loc} is air:
                                if shooter has scoreboard tag "team1":
                                    set block at {_loc} to red wool
                                else if shooter has scoreboard tag "team2":
                                    set block at {_loc} to blue wool
                                else:
                                    set block at {_loc} to white wool
                else:
                    kill projectile
                    send "&e&l[HLBW] &r&cNie możesz tego tutaj użyć" to shooter
    if projectile is an ender pearl:
        if shooter is a player:
            loop 9999 times:
                wait 1 tick
                if projectile is in region "tlen1":
                    set {_ype} to y-coordinate of projectile
                    if {_ype} > 160:
                        kill projectile
                        send "&e&l[HLBW] &r&cNie możesz tego tutaj użyć" to shooter
                        exit this loop
            

                



# Przy uderzeniu – spawn silverfish + wycelowanie w najbliższego wroga
on projectile hit:
    if projectile is a snowball:
        if projectile is in region "tlen2":
            spawn silverfish at location of projectile
            set {_sf} to last spawned silverfish
            apply strength 1 to {_sf} for 31 seconds
            apply resistance 2 to {_sf} for 31 seconds
            apply slow falling 1 to {_sf} for 10 seconds
            set {_locp} to location of projectile
            set {_mind} to 100000
            loop all players:
                set {_d} to distance between {_locp} and location of loop-player
                if {_d} < {_mind}:
                    set {_mind} to {_d}
                    set {_nearest} to loop-player
            if {_nearest} is set:
                set target of {_sf} to {_nearest}
            
            wait 30 seconds
            if {_sf} is alive:
                kill {_sf}

on rightclick with fire charge:
    if player is in region "tlen2":
        if player is in region "tlen3":
            send "&e&l[HLBW] &r&cNie możesz tego tutaj użyć" to player
        else:
            if player is in region "tlen4":
                send "&e&l[HLBW] &r&cNie możesz tego tutaj użyć" to player
            else:
                spawn fireball 1 block above the player
                push last spawned fireball in direction of player with force 1.5
                play sound "entity.ghast.shoot" with volume 1.0 and pitch 1.0 at player's location
                remove 1 of fire charge from player's inventory
    else:
        send "&e&l[HLBW] &r&cNie możesz tego tutaj użyć" to player

on place of tnt:
    if player is in region "tlen2":
        if player is in region "tlen3":
            cancel event
            send "&e&l[HLBW] &r&cNie możesz tego tutaj użyć" to player
        else:
            if player is in region "tlen4":
                cancel event
                send "&e&l[HLBW] &r&cNie możesz tego tutaj użyć" to player
            else:
                cancel event
                set event-block to air
                spawn primed tnt at event-location
                remove 1 of tnt from player's inventory
    else:
        cancel event
        send "&e&l[HLBW] &r&cNie możesz tego tutaj użyć" to player

aliases:
    dozwolone-bloki = red wool, blue wool, white wool, oak planks, cobblestone, end stone, obsidian, ladder, yellow stained glass, red bed, blue bed, fire
    wybuchajace-bloki = red wool, blue wool, white wool, oak planks, cobblestone, end stone, ladder, fire

on break:
    if player is in region "tlen2":
        if type of block is not dozwolone-bloki:
            cancel event
        
        if player has scoreboard tag "team1":
            if type of block is red bed:
                cancel event
                send "&e&l[HLBW] &r&cNie możesz niszczyć własnego łóżka" to player
            if type of block is blue bed:
                set {bluerespawn} to false
                execute console command "execute at @a run kill @e[type=item,nbt={Item:{id:""minecraft:blue_bed""}}]"
                broadcast "&e&l[HLBW] &r&fŁóżko &9&lNiebieskich &r&fzostało zniszczone!"
                execute console command "execute as @a at @s run playsound minecraft:item.trident.thunder master @s ~ ~1 ~ 10 1.0"
                wait 1 tick
                execute console command "execute at @a run kill @e[type=item,nbt={Item:{id:""minecraft:blue_bed""}}]"
        else if player has scoreboard tag "team2":
            if type of block is blue bed:
                cancel event
                send "&e&l[HLBW] &r&cNie możesz niszczyć własnego łóżka" to player
            if type of block is red bed:
                set {redrespawn} to false
                execute console command "execute at @a run kill @e[type=item,nbt={Item:{id:""minecraft:red_bed""}}]"
                broadcast "&e&l[HLBW] &r&fŁóżko &c&lCzerwonych &r&fzostało zniszczone!"
                execute console command "execute as @a at @s run playsound minecraft:item.trident.thunder master @s ~ ~1 ~ 10 1.0"
                wait 1 tick
                execute console command "execute at @a run kill @e[type=item,nbt={Item:{id:""minecraft:red_bed""}}]"
        else:
            if type of block is red bed:
                cancel event
                send "§cNie możesz zniszczyć innych łóżek!" to player
            if type of block is blue bed:
                cancel event
                send "§cNie możesz zniszczyć innych łóżek!" to player


on explosion:
    if event-location is in region "tlen2":
        loop exploded blocks:
            if type of loop-block is not wybuchajace-bloki:
                remove loop-block from exploded blocks
        
